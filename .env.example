# Mode lokal: jalankan API Compose Lab 06. Variabel ini hanya dipakai server Next.js.
LOCAL_API_URL=http://127.0.0.1:18006

# Mode Supabase: isi keduanya untuk memakai Auth + RLS Lab 07.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opsional: proxy model AI (/api/ai). Server-side saja, jangan pakai NEXT_PUBLIC_.
# Ollama lokal (tanpa key): http://127.0.0.1:11434/v1 dan model hf.co/bartowski/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# SESUAIKAN DI DEVICE-MU: laptop/CPU lambat + model lokal -> naikkan timeout atau kecilkan jawaban.
# Default bila kosong: AI_TIMEOUT_MS=20000 (20 detik), AI_MAX_TOKENS=300.
AI_TIMEOUT_MS=
AI_MAX_TOKENS=
# Opsional untuk pengujian `npm run start` di loopback. Kosongkan pada deployment publik.
AI_ENABLE_IN_PRODUCTION=
